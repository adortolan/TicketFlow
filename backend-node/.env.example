# Server Configuration
# Port where the Node.js server will listen
PORT=3001
# Environment mode (development, production, test)
NODE_ENV=development

# JWT Configuration
# Secret key used to sign and verify JWT tokens (change in production!)
JWT_SECRET=seu-segredo-super-secreto
# Token expiration time (e.g., 24h, 7d, 1h)
JWT_EXPIRES_IN=24h

# MySQL Configuration
# MySQL server hostname (use localhost for local development, mysql for Docker)
DB_HOST=localhost
# MySQL server port
DB_PORT=3306
# Database name
DB_NAME=ticketflow
# Database user
DB_USER=ticketflow
# Database password
DB_PASSWORD=ticketflow123

# RabbitMQ Configuration
# RabbitMQ connection URL with credentials (format: amqp://user:password@host:port)
RABBITMQ_URL=amqp://admin:admin@localhost:5672
# Queue name for order creation events
RABBITMQ_QUEUE_ORDER_CREATED=order.created
# Queue name for user registration events
RABBITMQ_QUEUE_USER_REGISTERED=user.registered
